{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/require-tests-before-push.sh\"",
            "timeout": 180,
            "statusMessage": "Running backend tests and frontend build before allowing push/PR..."
          }
        ]
      }
    ]
  }
}
